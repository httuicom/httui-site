---

<div class={root}>
  {/* TOP BAR */}
  <div class={topBar}>
    <div class={logoWrap}>
      <span class={logoSq}></span>
      <span>httui</span>
    </div>
    <div class={vDivider}></div>

    {/* Breadcrumb */}
    <div class={crumb}>
      <span>acme</span>
      <span set:html={icons.chevronRight(12)}></span>
      <span>payments</span>
      <span set:html={icons.chevronRight(12)}></span>
      <span class={crumbActive}>rollout-v2.3.md</span>
      <span class={dotBase} style={`background:${dotColor.warn}`}></span>
    </div>
    <div class={flex1}></div>

    {/* Env switcher */}
    <div class={envSwitcher}>
      {envs.map((env, i) => (
        <div
          class={envCell}
          style={`background:${env.active ? "var(--colors-bg-subtle)" : "transparent"};color:${env.active ? "var(--colors-fg)" : "var(--colors-fg-subtle)"};font-weight:${env.active ? 600 : 400};border-right:${i < 2 ? "1px solid var(--colors-border)" : "none"};`}
        >
          {env.prod && <span class={dotBase} style={`background:${dotColor.err}`}></span>}
          <span>{env.e}</span>
        </div>
      ))}
    </div>

    {/* Search */}
    <div class={search}>
      <span set:html={icons.search(12)}></span>
      <span class={searchTxt}>Search blocks, vars, schema…</span>
      <span class={kbd}>⌘K</span>
    </div>

    {/* Collaborators */}
    <div class={avatarStack}>
      {collabs.map((c, i) => (
        <span
          class={avatar}
          style={`background:${c.c};margin-left:${i === 0 ? 0 : "-6px"}`}
        >{c.n}</span>
      ))}
    </div>

    {/* Branch + Run all */}
    <div class={branchChip}>
      <span set:html={icons.gitBranch(12)}></span>
      <span>main</span>
    </div>
    <div class={runAll}>
      <span set:html={icons.play(11)}></span>
      <span>Run all</span>
    </div>
  </div>

  {/* LEFT SIDEBAR */}
  <div class={leftSidebar}>
    {/* Files */}
    <div class={paneHead}>
      <span>Files</span>
      <span class={flex1}></span>
      <span set:html={icons.plus(11)}></span>
    </div>
    <div class={filesBox}>
      {files.map((r) => (
        <div
          class={fileRow}
          style={`padding-left:${8 + r.depth * 12}px;color:${r.active ? "var(--colors-fg)" : "var(--colors-fg-muted)"};font-weight:${r.active ? 600 : 400};background:${r.active ? "var(--colors-bg-subtle)" : "transparent"};`}
        >
          <span class={fileChevSlot}>
            {r.folder ? (
              <span set:html={r.open ? icons.chevronDown(11) : icons.chevronRight(11)}></span>
            ) : null}
          </span>
          <span class={fileIconSlot} style={`color:${r.folder ? "var(--colors-fg-subtle)" : "var(--colors-accent)"}`}>
            {r.folder ? (
              <span set:html={r.open ? icons.folderOpen(12) : icons.folder(12)}></span>
            ) : (
              <span set:html={icons.file(12)}></span>
            )}
          </span>
          <span class={fileLabel}>{r.n}</span>
          {r.dirty && <span class={dotBase} style={`background:${dotColor.warn}`}></span>}
        </div>
      ))}
    </div>

    {/* Connections */}
    <div class={connectionsBox}>
      <div class={paneHead}>
        <span>Connections</span>
        <span class={flex1}></span>
        <span set:html={icons.plus(11)}></span>
      </div>
      <div style="padding-bottom:6px">
        {connections.map((c) => (
          <div class={connRow}>
            <span class={dotBase} style={`background:${dotColor[c.k]}`}></span>
            <span class={connIconSlot} set:html={icons.database(12)}></span>
            <span class={fileLabel}>{c.n}</span>
            {c.prod && <span class={prodPill}>PROD</span>}
            <span class={connLatency}>{c.l}ms</span>
          </div>
        ))}
      </div>
    </div>

    {/* Variables */}
    <div>
      <div class={paneHead}>
        <span>Variables — staging</span>
        <span class={flex1}></span>
        <span set:html={icons.plus(11)}></span>
      </div>
      <div style="padding-bottom:8px">
        {variables.map((v) => (
          <div class={varsRow}>
            <span class={varIconSlot} style={`color:${v.secret ? "var(--colors-warn)" : "var(--colors-fg-disabled)"}`}>
              {v.secret ? (
                <span set:html={icons.keyRound(11)}></span>
              ) : (
                <span style="display:inline-block;width:3px;height:3px;border-radius:9999px;background:var(--colors-fg-disabled)"></span>
              )}
            </span>
            <span class={varKey}>{v.k}</span>
            <span class={varVal}>{v.v}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* CENTER */}
  <div class={center}>
    {/* Tab bar */}
    <div class={tabBar}>
      <div class={tabActive}>
        <span class={tabIconAccent} set:html={icons.file(12)}></span>
        <span class={tabTxtActive}>rollout-v2.3.md</span>
        <span class={dotBase} style={`background:${dotColor.warn}`}></span>
        <span class={tabIconDisabled} style="margin-left:4px" set:html={icons.x(12)}></span>
      </div>
      <div class={tab}>
        <span class={tabIconDisabled} set:html={icons.file(12)}></span>
        <span class={tabTxt}>rollback.md</span>
        <span class={tabIconDisabled} set:html={icons.x(12)}></span>
      </div>
      <div class={tab}>
        <span class={tabIconDisabled} set:html={icons.file(12)}></span>
        <span class={tabTxt}>ad-hoc.md</span>
        <span class={tabIconDisabled} set:html={icons.x(12)}></span>
      </div>
      <div class={tabSpacer}></div>
      <div class={tabRightCluster}>
        <span set:html={icons.arrowLeftRight(14)}></span>
        <span set:html={icons.users(14)}></span>
        <span set:html={icons.settings(14)}></span>
      </div>
    </div>

    {/* Editor toolbar */}
    <div class={editorToolbar}>
      <span>runbooks / payments / rollout-v2.3.md</span>
      <span>·</span>
      <span>edited há 4 min by rafael</span>
      <span class={flex1}></span>
      <span style="font-family:var(--fonts-mono)">10 blocks · 4 ran · 1 pending</span>
      <span>·</span>
      <span class={autoCapture}>
        <span set:html={icons.zap(11)}></span>
        <span>auto-capture</span>
      </span>
    </div>

    {/* Document */}
    <div class={docBox}>
      <div class={docInner}>
        {/* DocHeader */}
        <div class={docHeader}>
          <div class={docCrumb}>
            <span set:html={icons.folder(11)}></span>
            <span>runbooks</span>
            <span>/</span>
            <span>payments</span>
            <span>/</span>
            <span class={docCrumbActive}>rollout-v2.3.md</span>
            <span class={flex1}></span>
            <span class={draftPill}>
              <span class={dotBase} style={`background:${dotColor.warn}`}></span>
              <span>draft · 4 unsaved edits</span>
            </span>
          </div>

          <h1 class={docTitle}>Rollout — Payments v2.3 → staging</h1>

          <div class={metaStrip}>
            <span class={metaGroup}>
              <span class={metaAvatar} style="background:oklch(0.74 0.14 50)">R</span>
              <span style="color:var(--colors-fg-muted)">rafael</span>
            </span>
            <span>·</span>
            <span>edited <span class={metaMono}>há 4 min</span></span>
            <span>·</span>
            <span style="font-family:var(--fonts-mono)">10 blocks</span>
            <span>·</span>
            <span class={metaGroup}>
              <span set:html={icons.gitBranch(11)}></span>
              <span class={metaMono}>main</span>
              <span class={metaAccent}>+3 ~1</span>
            </span>
            <span>·</span>
            <span class={metaOk}>
              <span class={dotBase} style={`background:${dotColor.ok}`}></span>
              <span>last run 14:23 — all green</span>
            </span>
          </div>

          <p class={abstract}>
            Deploy do novo provider de cartão (<code class={abstractCode}>stripe_v2</code>) para o tenant <code class={abstractCode}>acme-payments</code> em staging. Antes de promover para prod, validar que a config foi propagada, que <code class={abstractCode}>payments_route</code> não tem rotas órfãs, e que a latência do stream de captura fica abaixo de 800ms.
          </p>

          <div class={preflightGrid}>
            <div class={preflightBox}>
              <div class={preflightTitle}>PRÉ-FLIGHT — 4 itens</div>
              <div class={preflightList}>
                {preflight.map((it) => (
                  <div
                    class={preflightRow}
                    style={`color:${it.ok ? "var(--colors-fg-subtle)" : "var(--colors-fg)"}`}
                  >
                    <span class={`${checkbox} ${it.ok ? checkboxDone : checkboxTodo}`}>
                      {it.ok && <span set:html={icons.check(10)}></span>}
                    </span>
                    <span
                      style={`text-decoration:${it.ok ? "line-through" : "none"};text-decoration-color:var(--colors-fg-disabled);`}
                    >
                      {it.t}
                      {it.code && <code class={inlineCode}>{it.code}</code>}
                    </span>
                  </div>
                ))}
              </div>
            </div>
            <div class={tagsCol}>
              <div class={tagsTitle}>TAGS</div>
              {tags.map((t) => <div class={tag}>{t}</div>)}
            </div>
          </div>
        </div>

        {/* Section 1 */}
        <div class={numSection}>
          <span class={numCircle}>1</span>
          <span class={numTitle}>Sanidade — health check do gateway</span>
          <span class={numRule}></span>
        </div>

        {/* Block 02 — HTTP GET */}
        <div class={blockShell}>
          <div class={blockHead}>
            <span class={blockIdx}>02</span>
            <span class={flex1}></span>
            <div class={blockHeadRight}>
              <span class={ranTxt}>ran 14:22:08</span>
              <span class={okMono}>
                <span class={dotBase} style={`background:${dotColor.ok}`}></span>
                <span>200 · 142ms</span>
              </span>
            </div>
          </div>
          <div class={blockBody}>
            <div style="display:flex;align-items:center;gap:8px">
              <span class={methodGet}>GET</span>
              <span class={urlMono}>{urlHealth}</span>
            </div>
            <div class={jsonBody}>
              <div>{"{"}</div>
              <div class={jsonIndent}>
                <span class={jKey}>"status"</span>: <span class={jOk}>"ok"</span>, <span class={jKey}>"version"</span>: <span class={jOk}>"2.3.0-rc4"</span>,
              </div>
              <div class={jsonIndent}>
                <span class={jKey}>"deps"</span>: <span class={jMuted}>{"{ "}</span><span class={jKey}>"db"</span>: <span class={jOk}>"ok"</span>, <span class={jKey}>"kafka"</span>: <span class={jWarn}>"degraded"</span><span class={jMuted}>{" }"}</span>
              </div>
              <div>{"}"}</div>
            </div>
          </div>
        </div>

        {/* Section 2 */}
        <div class={numSection}>
          <span class={numCircle}>2</span>
          <span class={numTitle}>Autenticar como admin do tenant</span>
          <span class={numRule}></span>
        </div>

        {/* Block 04 — POST */}
        <div class={blockShell}>
          <div class={blockHead}>
            <span class={blockIdx}>04</span>
            <span class={flex1}></span>
            <div class={blockHeadRight}>
              <span class={ranTxt}>ran 14:22:14</span>
              <span class={okMono}>
                <span class={dotBase} style={`background:${dotColor.ok}`}></span>
                <span>201 · 318ms</span>
              </span>
            </div>
          </div>
          <div class={blockBody}>
            <div style="display:flex;align-items:center;gap:8px">
              <span class={methodPost}>POST</span>
              <span class={urlMono}>{urlAuth}</span>
            </div>
            <div class={jsonBody}>
              <div>
                <span class={headerSubtle}>Authorization</span>: Bearer <span class={jKey}>{adminTok}</span>
              </div>
              <div>
                <span class={headerSubtle}>X-Tenant</span>: <span class={jKey}>{tenantTok}</span>
              </div>
            </div>
          </div>
          <div class={blockFooter}>
            <span class={linkIconAccent} set:html={icons.link(11)}></span>
            <span>captured →</span>
            <span class={capturedMono}>SESSION_ID</span>
            <span style="font-family:var(--fonts-mono)">= ses_01HZ4RTQ8VK7…</span>
          </div>
        </div>

        {/* Section 3 */}
        <div class={numSection}>
          <span class={numCircle}>3</span>
          <span class={numTitle}>Verificar rotas órfãs no banco</span>
          <span class={numRule}></span>
        </div>

        {/* Block 06 — SQL */}
        <div class={blockShell}>
          <div class={blockHead}>
            <span class={blockIdx}>06</span>
            <span class={blockKindLabel} style="background:oklch(0.42 0.10 290)">SQL</span>
            <span class={flex1}></span>
            <div class={blockHeadRight}>
              <span class={ranTxt}>pg · payments@staging</span>
              <span class={okMono}>
                <span class={dotBase} style={`background:${dotColor.ok}`}></span>
                <span>3 rows · 47ms</span>
              </span>
            </div>
          </div>
          <div class={blockBody}>
            <div class={sqlBody}>
              <div><span class={sqlKw}>SELECT</span> r.id, r.tenant_id, r.provider_key</div>
              <div><span class={sqlKw}>FROM</span> payments_route r</div>
              <div><span class={sqlKw}>LEFT JOIN</span> payment_provider p <span class={sqlKw}>ON</span> p.key = r.provider_key</div>
              <div><span class={sqlKw}>WHERE</span> p.key <span class={sqlKw}>IS NULL</span>;</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* RIGHT SIDEBAR */}
  <div class={rightSidebar}>
    {/* Tabs */}
    <div class={rightTabs}>
      {rightTabsList.map((t, i) => {
        const active = t === "Schema";
        const last = i === rightTabsList.length - 1;
        return (
          <div
            class={rightTab}
            style={`font-weight:${active ? 600 : 500};color:${active ? "var(--colors-fg)" : "var(--colors-fg-subtle)"};background:${active ? "var(--colors-bg-surface)" : "transparent"};border-bottom:1px solid ${active ? "var(--colors-accent)" : "transparent"};border-right:${!last ? "1px solid var(--colors-border)" : "none"};`}
          >
            <span>{t}</span>
            {t === "Comments" && <span class={commentsBadge}>2</span>}
          </div>
        );
      })}
    </div>

    {/* Schema panel */}
    <div style="flex:1;overflow:hidden">
      <div class={paneHead}>
        <span>Database</span>
        <span class={flex1}></span>
        <span style="font-size:10px;color:var(--colors-fg-disabled)">payments</span>
      </div>
      <div class={dbHeadInfo}>
        <span class={dotBase} style={`background:${dotColor.ok}`}></span>
        <span>pg · payments@staging · 18ms</span>
      </div>

      {/* public schema */}
      <div class={schemaRow}>
        <span style="color:var(--colors-fg-disabled);display:flex;align-items:center" set:html={icons.chevronDown(11)}></span>
        <span style="color:var(--colors-fg-subtle);display:flex;align-items:center" set:html={icons.database(12)}></span>
        <span>public</span>
        <span class={flex1}></span>
        <span class={schemaCount}>5</span>
      </div>

      {schemaTables.map((t) => (
        <div>
          <div
            class={tableRow}
            style={`padding-left:26px;font-weight:${t.open ? 600 : 400};background:${t.open ? "var(--colors-bg-elevated)" : "transparent"};`}
          >
            <span style="color:var(--colors-fg-disabled);display:flex;align-items:center" set:html={t.open ? icons.chevronDown(11) : icons.chevronRight(11)}></span>
            <span style="color:var(--colors-fg-subtle);display:flex;align-items:center" set:html={icons.table(11)}></span>
            <span style="font-family:var(--fonts-mono)">{t.n}</span>
            <span class={flex1}></span>
            <span class={monoDisabled} style="font-size:10px">{t.rows}</span>
          </div>
          {t.open && routeCols.map((c) => (
            <div class={tableRowCols} style="padding-left:50px">
              <span
                class={tableRowColKey}
                style={`color:${c.pk ? "var(--colors-warn)" : c.fk ? "var(--colors-info)" : "var(--colors-fg-disabled)"}`}
              >
                {c.pk ? (
                  <span set:html={icons.keyRound(10)}></span>
                ) : c.fk ? (
                  <span set:html={icons.link(10)}></span>
                ) : (
                  <span style="display:inline-block;width:3px;height:3px;border-radius:9999px;background:var(--colors-fg-disabled)"></span>
                )}
              </span>
              <span class={monoFg}>{c.k}</span>
              <span class={flex1}></span>
              <span class={monoDisabled}>{c.t}</span>
            </div>
          ))}
        </div>
      ))}

      {/* billing schema */}
      <div class={schemaRow} style="margin-top:6px">
        <span style="color:var(--colors-fg-disabled);display:flex;align-items:center" set:html={icons.chevronRight(11)}></span>
        <span style="color:var(--colors-fg-subtle);display:flex;align-items:center" set:html={icons.database(12)}></span>
        <span>billing</span>
        <span class={flex1}></span>
        <span class={schemaCount}>3</span>
      </div>

      {/* History */}
      <div class={hrLine}></div>
      <div class={paneHead}>
        <span>History</span>
        <span class={flex1}></span>
        <span style="font-size:10px;color:var(--colors-fg-disabled)">6</span>
      </div>
      {history.map((h) => (
        <div class={histRow}>
          <span class={histAt}>{h.at}</span>
          <span class={histLabel}>{h.label}</span>
          <span class={histInfo} style={`color:${h.k === "ok" ? "var(--colors-ok)" : "var(--colors-info)"}`}>{h.info}</span>
        </div>
      ))}
    </div>

    {/* AI bar */}
    <div class={aiBar}>
      <div class={aiHead}>
        <span style="color:var(--colors-accent);display:flex;align-items:center" set:html={icons.sparkles(12)}></span>
        <span style="color:var(--colors-fg);font-weight:600">Ask httui</span>
        <span class={flex1}></span>
        <span class={kbd}>⌘J</span>
      </div>
      <div class={aiInput}>
        <span>Por que kafka está degraded?</span>
      </div>
    </div>
  </div>

  {/* STATUS BAR */}
  <div class={statusBar}>
    <span class={statusGroup}>
      <span set:html={icons.gitBranch(11)}></span>
      <span>main · 3 changes</span>
    </span>
    <span class={vDivider} style="height:12px"></span>
    <span class={statusGroup}>
      <span class={dotBase} style={`background:${dotColor.ok}`}></span>
      <span>connected · staging</span>
    </span>
    <span class={vDivider} style="height:12px"></span>
    <span>pg 18ms</span>
    <span>api 142ms</span>
    <span class={vDivider} style="height:12px"></span>
    <span>Ln 47, Col 12</span>
    <span class={flex1}></span>
    <span>UTF-8</span>
    <span class={vDivider} style="height:12px"></span>
    <span class={statusGroup} style="color:var(--colors-accent)">
      <span set:html={icons.zap(10)}></span>
      <span>chained</span>
    </span>
    <span class={vDivider} style="height:12px"></span>
    <span>httui 0.4.2</span>
  </div>
</div>
