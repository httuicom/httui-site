const history: HistEntry[] = [
  { at: "14:24:07", label: "WS captures", info: "14 msgs", k: "info" },
  { at: "14:23:01", label: "SELECT … rotas órfãs", info: "3 rows · 47ms", k: "ok" },
  { at: "14:22:14", label: "POST /v2/auth/admin", info: "201 · 318ms", k: "ok" },
