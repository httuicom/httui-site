---
import { css } from "../../styled-system/css";
import Logo from "./Logo.astro";
import { repoUrl, stats, docsHref } from "../lib/i18n";

interface Props {
  lang?: "en" | "pt-br" | "es";
}
const { lang = "en" } = Astro.props;

const blob = `${repoUrl}/blob/main`;
const docsBase = lang === "en" ? "/docs" : `/${lang}/docs`;

const copy = {
  en: {
    tagline: `The markdown editor for debugging APIs and databases. Open source · MIT · ${stats.version}.`,
    made: "Made with markdown.",
    copyright: "© 2026 httui contributors",
    cols: [
      { h: "Product", l: [
        { t: "Download", href: "#install" },
        { t: "Changelog", href: `${blob}/CHANGELOG.md` },
      ]},
      { h: "Docs", l: [
        { t: "Quickstart", href: `${docsBase}/tutorials/quickstart` },
        { t: "How-to guides", href: `${docsBase}/how-to/environments` },
        { t: "Reference", href: `${docsBase}/reference/http-block` },
        { t: "Architecture", href: `${docsBase}/architecture` },
      ]},
      { h: "Community", l: [
        { t: "GitHub", href: repoUrl },
        { t: "Contributing", href: `${blob}/CONTRIBUTING.md` },
        { t: "Code of Conduct", href: `${blob}/CODE_OF_CONDUCT.md` },
      ]},
      { h: "Legal", l: [
        { t: "MIT License", href: `${blob}/LICENSE` },
        { t: "Security", href: `${blob}/SECURITY.md` },
      ]},
    ],
  },
  "pt-br": {
    tagline: `Editor markdown pra debugar APIs e bancos. Código aberto · MIT · ${stats.version}.`,
    made: "Feito com markdown.",
    copyright: "© 2026 colaboradores do httui",
    cols: [
      { h: "Produto", l: [
        { t: "Download", href: "#install" },
        { t: "Novidades", href: `${blob}/CHANGELOG.md` },
      ]},
      { h: "Docs", l: [
        { t: "Quickstart", href: `${docsBase}/tutorials/quickstart` },
        { t: "Guias práticos", href: `${docsBase}/how-to/environments` },
        { t: "Referência", href: `${docsBase}/reference/http-block` },
        { t: "Arquitetura", href: `${docsBase}/architecture` },
      ]},
      { h: "Comunidade", l: [
        { t: "GitHub", href: repoUrl },
        { t: "Contribuir", href: `${blob}/CONTRIBUTING.md` },
        { t: "Código de conduta", href: `${blob}/CODE_OF_CONDUCT.md` },
      ]},
      { h: "Legal", l: [
        { t: "Licença MIT", href: `${blob}/LICENSE` },
        { t: "Segurança", href: `${blob}/SECURITY.md` },
      ]},
    ],
  },
  es: {
    tagline: `Editor markdown para depurar APIs y bases de datos. Código abierto · MIT · ${stats.version}.`,
    made: "Hecho con markdown.",
    copyright: "© 2026 colaboradores de httui",
    cols: [
      { h: "Producto", l: [
        { t: "Download", href: "#install" },
        { t: "Cambios", href: `${blob}/CHANGELOG.md` },
      ]},
      { h: "Docs", l: [
        { t: "Quickstart", href: `${docsBase}/tutorials/quickstart` },
        { t: "Guías prácticas", href: `${docsBase}/how-to/environments` },
        { t: "Referencia", href: `${docsBase}/reference/http-block` },
        { t: "Arquitectura", href: `${docsBase}/architecture` },
      ]},
      { h: "Comunidad", l: [
        { t: "GitHub", href: repoUrl },
        { t: "Contribuir", href: `${blob}/CONTRIBUTING.md` },
        { t: "Código de Conducta", href: `${blob}/CODE_OF_CONDUCT.md` },
      ]},
      { h: "Legal", l: [
        { t: "Licencia MIT", href: `${blob}/LICENSE` },
        { t: "Seguridad", href: `${blob}/SECURITY.md` },
      ]},
    ],
  },
};
const t = copy[lang];

const footer = css({
  px: { base: "6", md: "20" },
  pt: "14",
  pb: "9",
  bg: "bg.surface",
  borderTopWidth: "1px",
  borderColor: "border",
  fontSize: "xs",
  color: "fg.muted",
});
const grid = css({
  display: "grid",
  gridTemplateColumns: { base: "repeat(2, 1fr)", md: "repeat(5, 1fr)" },
  gap: "10",
  maxW: "1280px",
  mx: "auto",
});
const brandCol = css({ gridColumn: { base: "span 2", md: "span 1" } });
const tagline = css({
  mt: "3",
  fontSize: "13px",
  lineHeight: "1.55",
  maxW: "280px",
});
const colHead = css({
  fontSize: "11px",
  fontWeight: "700",
  letterSpacing: "wide",
  color: "fg",
  mb: "3",
});
const colList = css({
  display: "flex",
  flexDirection: "column",
  gap: "1.5",
  fontSize: "13px",
  color: "fg.muted",
});
const link = css({
  cursor: "pointer",
  textDecoration: "none",
  color: "fg.muted",
  _hover: { color: "fg" },
});
const bar = css({
  mt: "10",
  pt: "4.5",
  borderTopWidth: "1px",
  borderColor: "border",
  display: "flex",
  justifyContent: "space-between",
  maxW: "1280px",
  mx: "auto",
  flexDirection: { base: "column", md: "row" },
  gap: "2",
});
const barRight = css({
  display: "flex",
  alignItems: "center",
  gap: "3",
});
const toggleBtn = css({
  display: "inline-flex",
  alignItems: "center",
  gap: "1.5",
  px: "2",
  py: "1",
  rounded: "full",
  borderWidth: "1px",
  borderColor: "border.subtle",
  color: "fg.muted",
  cursor: "pointer",
  bg: "transparent",
  transition: "color 0.15s, border-color 0.15s",
  _hover: { color: "fg", borderColor: "border" },
});
const toggleText = css({
  fontSize: "11px",
  fontFamily: "mono",
});
---

<footer class={footer}>
  <div class={grid}>
    <div class={brandCol}>
      <Logo variant="logo" size={28} />
      <p class={tagline}>{t.tagline}</p>
    </div>
    {t.cols.map((col) => (
      <div>
        <div class={colHead}>{col.h}</div>
        <div class={colList}>
          {col.l.map((x) => (
            <a
              class={link}
              href={x.href}
              {...(x.href.startsWith("#") || x.href.startsWith("/") ? {} : { target: "_blank", rel: "noreferrer" })}
            >
              {x.t}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class={bar}>
    <span>{t.copyright}</span>
    <div class={barRight}>
      <span>{t.made}</span>
      <button type="button" id="theme-toggle" class={toggleBtn} aria-label="Toggle theme">
        <svg data-theme-icon="dark" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <svg data-theme-icon="light" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <span class={toggleText} data-theme-label></span>
      </button>
    </div>
  </div>
</footer>

<style is:global>
  [data-theme-icon] { display: none; }
  html[data-theme="dark"]  [data-theme-icon="dark"]  { display: inline-block; }
  html[data-theme="light"] [data-theme-icon="light"] { display: inline-block; }
</style>

<script>
  const btn = document.getElementById("theme-toggle");
  const label = btn?.querySelector("[data-theme-label]") as HTMLElement | null;
  const sync = () => {
    if (label) label.textContent = document.documentElement.dataset.theme || "light";
  };
  sync();
  btn?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    sync();
  });
</script>
